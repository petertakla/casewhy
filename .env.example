# USCIS Torch API (developer.uscis.gov) credentials.
# Obtained by registering an app at https://developer.uscis.gov/get-started
# Sandbox and production use different client credentials — never mix them.
USCIS_ENV=sandbox                # "sandbox" | "production"
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=

# FOIA Request and Status API uses its OWN Torch credential pair — USCIS
# confirmed Sep 5, 2026 that the FOIA and Case Status credentials for a
# given app are genuinely different pairs, not interchangeable, despite
# looking like an unused duplicate at first.
USCIS_FOIA_CLIENT_ID=
USCIS_FOIA_CLIENT_SECRET=

# Token + API base URLs. Sandbox values below are from the USCIS Developer
# Portal docs (Sep 2026) — confirm against the portal before first use, and
# fill in the production equivalents once production access is granted.
USCIS_SANDBOX_TOKEN_URL=https://api-int.uscis.gov/oauth/accesstoken
USCIS_SANDBOX_API_BASE=https://api-int.uscis.gov
USCIS_PRODUCTION_TOKEN_URL=
USCIS_PRODUCTION_API_BASE=

# AI explanation layer
ANTHROPIC_API_KEY=

# Database (Neon Postgres, via `vercel env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (managed Better Auth) — see console.neon.tech project → Auth
NEON_AUTH_BASE_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# App-level encryption for sensitive DB columns (e.g. tracked_cases.receipt_number).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Status-change email notifications
# Postmark Server API Token (postmarkapp.com) — sends from info@casewhy.com. If
# unset, sendStatusChangeEmail() no-ops with a warning instead of throwing.
POSTMARK_API_TOKEN=
# Bearer token the /api/cron/check-status route requires. The external
# scheduler must send it as "Authorization: Bearer <this value>" — literal
# "Bearer " prefix required.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# CW-38 document vault — Vercel Blob (private access). Set automatically by
# `vercel blob create-store` / `vercel env pull`, not by hand.
BLOB_READ_WRITE_TOKEN=

# Round 13 — CaseWhy Plus live billing (Stripe). Use TEST MODE keys
# (sk_test_..., whsec_... from a test-mode webhook endpoint or `stripe
# listen`) until Peter explicitly authorizes flipping to live keys — see
# CLOUD_CLAUDE.md round 13. Never commit real values here.
STRIPE_SECRET_KEY=
# Price ID for the CaseWhy Plus $9.99/mo recurring price, created once in
# the Stripe dashboard (or via the API) — not something the app creates
# on the fly.
STRIPE_PLUS_PRICE_ID=
# Signing secret for the /api/webhooks/stripe endpoint's specific webhook
# destination (one value per environment — local via `stripe listen`,
# deployed via a dashboard-created webhook endpoint).
STRIPE_WEBHOOK_SECRET=

# Round 90/91 — social posters (src/lib/marketing/posters/*.ts), Production
# only. Round-90-prep correction: this list is the real, code-verified set
# -- earlier drafts of the setup task named Meta/Instagram/Gemini vars no
# code here actually reads (Facebook/Instagram are deliberately manual-
# post-only per round 91's own registry comment; Gemini goes through the
# Vercel AI Gateway credentials already used everywhere else, no separate
# key). Each poster treats "REPLACE_ME" the same as unset (src/lib/
# marketing/posters/env.ts) -- safe to leave these as placeholders.

# X (Twitter) — OAuth 1.0a user-context, from a Free-tier X Developer app
# (developer.x.com). All four required. X_HANDLE is optional, defaults to
# "CaseWhy" in code — only set it if the real handle differs.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_HANDLE=

# Threads — a Meta developer app's Threads API, a long-lived access token
# + the CaseWhy account's Threads user id. Not the general Instagram
# Graph API, and no separate app id/secret needed at post time.
# THREADS_HANDLE is optional, defaults to "casewhy" in code.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_HANDLE=

# Facebook Page — same Meta app as Threads. FACEBOOK_PAGE_ID is the Page's
# own id (public, not secret). FACEBOOK_PAGE_ACCESS_TOKEN comes from the
# Page's owning Business Portfolio's `owned_pages` edge, not the classic
# `me/accounts` edge -- the CaseWhy Page is a Meta "Profile Plus" business
# profile and doesn't appear via the classic route (see facebook.ts's own
# comment).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Pinterest — a trial-access Pinterest app's long-lived access token
# (developers.pinterest.com) + the destination board's id. No OAuth
# redirect flow at post time.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# YouTube (Shorts) — a Google Cloud OAuth2 client (YouTube Data API v3
# enabled) + a refresh token obtained once via /api/admin/youtube-oauth/
# start while signed in as admin.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# SEO — Organization/WebSite JSON-LD's sameAs field (src/lib/seo/
# organization-jsonld.ts). Comma-separated real profile URLs; omitted
# entirely (not a fake placeholder) if unset.
SOCIAL_SAME_AS_URLS=

# TikTok — Content Posting API. Only the static app-level Client Key/
# Secret live here; the user-level access/refresh tokens are obtained
# via /api/admin/tiktok-oauth/start (signed in as admin) and stored in
# the DB, not an env var -- TikTok's refresh token rotates on its own
# (see tiktokOauthToken in schema.ts and tiktok.ts's own comment).
# TIKTOK_HANDLE is optional, defaults to "casewhyapp" in code.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_HANDLE=
